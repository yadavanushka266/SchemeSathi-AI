TELEPHONY_PROVIDER=exotel
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_CALLBACK_NUMBER=

SMS_PROVIDER=msg91
SMS_API_KEY=

OCR_PROVIDER=google_vision
OCR_API_KEY=

AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
