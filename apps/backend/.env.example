ENV=development
APP_NAME=SchemeSathi_AI

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scheme_matching
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-this-to-a-long-random-value-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute

# Used only for optional natural-language explanation phrasing and as a
# fallback STT/TTS provider. Deterministic rules remain authoritative for
# eligibility -- the LLM never decides who qualifies.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

# --- Telephony (missed call + callback) ---
TELEPHONY_PROVIDER=exotel
WEBHOOK_SHARED_SECRET=

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VOICE_WEBHOOK_URL=

# --- SMS (outreach/awareness) ---
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SCHMAT
MSG91_TEMPLATE_ID=

# --- Bhashini (Digital India) — primary voice/language layer ---
VOICE_AI_PROVIDER=bhashini
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_DEFAULT_LANGUAGE=hi

# --- OCR ---
OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=

# --- Storage ---
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

EMAIL_PROVIDER=ses
EMAIL_FROM_ADDRESS=no-reply@scheme-matching.gov.in
